<?xml version="1.0"?>
<robot name="X_Mem">
  
  <!-- Cross Member Link -->
  <link name="X_Mem_link">
    <visual>
      <geometry>
        <box size="0.05 1.5 0.05"/>  <!-- X = 0.05m, Y = 1.5m, Z = 0.05m -->
      </geometry>
      <material name="blue">
        <color rgba="0.0 0.0 1.0 1.0"/>  <!-- Blue color for visibility -->
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.05 1.5 0.05"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="0.5"/>  <!-- Adjust mass as needed -->
      <origin xyz="0 0 0"/>
      <inertia ixx="0.002" ixy="0.0" ixz="0.0"
               iyy="0.15" iyz="0.0"
               izz="0.002"/>
    </inertial>
  </link>

  <!-- Fixed Joint (Optional) -->
  <joint name="cross_member_fixed" type="fixed">
    <parent link="world"/>  <!-- Attach to world or another robot part -->
    <child link="cross_member_link"/>
    <origin xyz="0 0 0"/>
  </joint>

</robot>
